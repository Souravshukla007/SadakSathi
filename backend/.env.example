# FastAPI ML backend config. backend/.env is gitignored; commit only backend/.env.example.

DEBUG=false             # true also serves the API docs at /docs
DEVICE="auto"            # auto | cpu | cuda

# Model weights. Defaults are the committed files in backend/models; uncomment to override.
# MODEL_PATH="models/best_whole_model_nano.pt"
# TRAFFIC_MODEL_PATH="models/traffic_model_nano_worse.pt"
TRACKER="bytetrack.yaml"
# Plate reading with Florence-2 (~1 GB RAM, ~1.6 s per plate on CPU). false = plates detected, not read.
OCR_ENABLED=true

# Parallel processing: true loads PARALLEL_WORKERS copies of each detection model so that many
# requests run at once (more RAM, ~50-100 MB per copy). false = one request per model at a time.
PARALLEL_PROCESSING=false
PARALLEL_WORKERS=2

# Shared secret the web app sends (must match ML_API_KEY in the root .env). Empty = open (local dev only).
ML_API_KEY=""

