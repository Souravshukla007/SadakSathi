# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/sadaksathi?schema=public"

# Signs login cookies. Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Password for the municipal/traffic accounts created by: node seed-authorities.js
AUTHORITY_SEED_PASSWORD=""

# Google sign-in (leave empty to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public URL of this web app (used for OAuth redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# FastAPI ML backend
FASTAPI_BASE_URL="http://127.0.0.1:8000"
# Shared secret sent to the ML backend as X-API-Key (must match ML_API_KEY in backend/.env)
ML_API_KEY=""

# Android app (Capacitor) loads this URL; leave empty to use the bundled files
CAPACITOR_SERVER_URL=""

# ── Deployment with docker compose (Raspberry Pi / Linux server) ─────────────
# Public name of the server. A real domain gets a Let's Encrypt certificate (ports 80/443 must
# reach the Pi); for a home network use e.g. raspberrypi.local with CADDY_TLS=internal.
SITE_ADDRESS="raspberrypi.local"
# "internal" = Caddy's own certificate authority (LAN); or your email for Let's Encrypt.
CADDY_TLS="internal"
# Letters and digits only: it is placed inside DATABASE_URL, where / @ # : break the address.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=""
# ML server tuning (see backend/.env.example for what each does). Pi defaults shown.
OCR_ENABLED=false
PARALLEL_PROCESSING=false
PARALLEL_WORKERS=2
ML_THREADS=4
